{
  "name": "heav3ns-muse",
  "version": "1.0.0",
  "description": "Agent-native digital audio workstation built on LMMS C++ DSP models. Embeds autonomous reasoning loops into an in-process, headless studio to inspect, compose, synthesize, mix, render, and perceptually critique music with sample-accurate determinism.",
  "homepage": "https://github.com/CardSorting/heav3ns-muse#readme",
  "keywords": [
    "agent-native",
    "ai-music",
    "audio-dsp",
    "audio-engine",
    "autonomous-agents",
    "cpp20",
    "daw",
    "digital-audio-workstation",
    "generative-music",
    "headless",
    "lmms",
    "midi",
    "multimodal-ai",
    "music-production",
    "piano-roll",
    "python-sdk",
    "sound-design",
    "synthesizer",
    "vst"
  ],
  "private": true,
  "scripts": {
    "docs:sync": "python3 scripts/docs-kb.py sync && python3 scripts/roadmap-sync.py sync",
    "docs:check": "python3 tests/test_docs_kb.py && python3 scripts/verify-docs.py && python3 scripts/docs-kb.py check && python3 scripts/roadmap-sync.py check",
    "docs:status": "python3 scripts/docs-kb.py status",
    "docs:impact": "python3 scripts/docs-kb.py impact",
    "docs:review": "python3 scripts/docs-kb.py review",
    "docs:audit": "python3 scripts/docs-kb.py audit",
    "docs:search": "python3 scripts/docs-kb.py search",
    "maintainer:check": "python3 scripts/onboard-maintainer.py",
    "maintainer:preflight": "python3 scripts/onboard-maintainer.py",
    "roadmap:sync": "python3 scripts/roadmap-sync.py sync",
    "roadmap:check": "python3 scripts/roadmap-sync.py check",
    "roadmap:roll": "python3 scripts/roadmap-sync.py roll",
    "test:kb": "python3 tests/test_docs_kb.py",
    "test:studio": "python3 tests/studio_process_test.py --lmms build/lmms --output build/studio-evidence"
  },
  "license": "GPL-2.0-or-later"
}
